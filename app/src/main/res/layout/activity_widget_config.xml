<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/widget_surface">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_config_title" android:textColor="@color/widget_text" android:textSize="24sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/widget_config_hint" android:textColor="@color/widget_muted" android:textSize="13sp" android:lineSpacingExtra="2dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/widget_income_section" android:textColor="@color/widget_green" android:textSize="13sp" android:textStyle="bold"/>
<EditText android:id="@+id/income_1_name" style="@style/WidgetConfigField" android:hint="Lương" android:inputType="textCapSentences" android:maxLength="18"/>
<EditText android:id="@+id/income_2_name" style="@style/WidgetConfigField" android:hint="Thưởng" android:inputType="textCapSentences" android:maxLength="18"/>
<EditText android:id="@+id/income_3_name" style="@style/WidgetConfigField" android:hint="Bán hàng" android:inputType="textCapSentences" android:maxLength="18"/>
<EditText android:id="@+id/income_4_name" style="@style/WidgetConfigField" android:hint="Thu khác" android:inputType="textCapSentences" android:maxLength="18"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/widget_expense_section" android:textColor="@color/widget_red" android:textSize="13sp" android:textStyle="bold"/>
<EditText android:id="@+id/expense_1_name" style="@style/WidgetConfigField" android:hint="Ăn uống" android:inputType="textCapSentences" android:maxLength="18"/>
<EditText android:id="@+id/expense_2_name" style="@style/WidgetConfigField" android:hint="Đi lại" android:inputType="textCapSentences" android:maxLength="18"/>
<EditText android:id="@+id/expense_3_name" style="@style/WidgetConfigField" android:hint="Mua sắm" android:inputType="textCapSentences" android:maxLength="18"/>
<EditText android:id="@+id/expense_4_name" style="@style/WidgetConfigField" android:hint="Chi khác" android:inputType="textCapSentences" android:maxLength="18"/>
<Button android:id="@+id/save_widget" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="22dp" android:layout_marginBottom="24dp" android:background="@drawable/widget_open_button" android:text="@string/widget_save" android:textColor="@color/widget_white" android:textSize="14sp" android:textStyle="bold"/>
</LinearLayout></ScrollView>